<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:tns="urn:iso:std:iso:20022:tech:xsd:pain.001.001.11"
  targetNamespace="urn:iso:std:iso:20022:tech:xsd:pain.001.001.11"
  elementFormDefault="qualified" attributeFormDefault="unqualified">

  <xs:simpleType name="Max35Text"><xs:restriction base="xs:string"><xs:maxLength value="35"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Max70Text"><xs:restriction base="xs:string"><xs:maxLength value="70"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Max140Text"><xs:restriction base="xs:string"><xs:maxLength value="140"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Max34Text"><xs:restriction base="xs:string"><xs:maxLength value="34"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Max15NumericText"><xs:restriction base="xs:string"><xs:pattern value="[0-9]{1,15}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="ActiveOrHistoricCurrencyCode"><xs:restriction base="xs:string"><xs:pattern value="[A-Z]{3}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="BICFIIdentifier"><xs:restriction base="xs:string"><xs:pattern value="[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="IBAN2007Identifier"><xs:restriction base="xs:string"><xs:minLength value="15"/><xs:maxLength value="34"/><xs:pattern value="[A-Z0-9]+"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="ISODate"><xs:restriction base="xs:date"/></xs:simpleType>
  <xs:simpleType name="ISODateTime"><xs:restriction base="xs:dateTime"/></xs:simpleType>
  <xs:simpleType name="ChargeBearerType1Code">
    <xs:restriction base="xs:string">
      <xs:enumeration value="DEBT"/>
      <xs:enumeration value="CRED"/>
      <xs:enumeration value="SHAR"/>
      <xs:enumeration value="SLEV"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ActiveCurrencyAndAmount">
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="Ccy" type="tns:ActiveOrHistoricCurrencyCode" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="PartyIdentification135">
    <xs:sequence>
      <xs:element name="Nm" type="tns:Max140Text"/>
      <xs:element name="PstlAdr" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="AdrLine" type="tns:Max70Text" minOccurs="0" maxOccurs="2"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AccountIdentification4Choice">
    <xs:choice>
      <xs:element name="IBAN" type="tns:IBAN2007Identifier"/>
      <xs:element name="Othr">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Id" type="tns:Max34Text"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="CashAccount38">
    <xs:sequence>
      <xs:element name="Id" type="tns:AccountIdentification4Choice"/>
      <xs:element name="Ccy" type="tns:ActiveOrHistoricCurrencyCode" minOccurs="0"/>
      <xs:element name="Nm" type="tns:Max70Text" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FinancialInstitutionIdentification18">
    <xs:sequence>
      <xs:element name="BICFI" type="tns:BICFIIdentifier" minOccurs="0"/>
      <xs:element name="Nm" type="tns:Max140Text" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ServiceLevel8Choice">
    <xs:sequence>
      <xs:element name="Cd" type="tns:Max35Text"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PaymentTypeInformation26">
    <xs:sequence>
      <xs:element name="SvcLvl" type="tns:ServiceLevel8Choice" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RemittanceInformation16">
    <xs:sequence>
      <xs:element name="Ustrd" type="tns:Max140Text" minOccurs="0" maxOccurs="2"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CreditTransferTransaction">
    <xs:sequence>
      <xs:element name="PmtId">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="EndToEndId" type="tns:Max35Text"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Amt">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="InstdAmt" type="tns:ActiveCurrencyAndAmount"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="ChrgBr" type="tns:ChargeBearerType1Code" minOccurs="0"/>
      <xs:element name="CdtrAgt" type="tns:FinancialInstitutionIdentification18" minOccurs="0"/>
      <xs:element name="Cdtr" type="tns:PartyIdentification135"/>
      <xs:element name="CdtrAcct" type="tns:CashAccount38" minOccurs="0"/>
      <xs:element name="UltmtCdtr" type="tns:PartyIdentification135" minOccurs="0"/>
      <xs:element name="DbtrAgt" type="tns:FinancialInstitutionIdentification18" minOccurs="0"/>
      <xs:element name="Dbtr" type="tns:PartyIdentification135" minOccurs="0"/>
      <xs:element name="UltmtDbtr" type="tns:PartyIdentification135" minOccurs="0"/>
      <xs:element name="Purp" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Cd" type="tns:Max35Text"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="RmtInf" type="tns:RemittanceInformation16" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PaymentInstruction">
    <xs:sequence>
      <xs:element name="PmtInfId" type="tns:Max35Text"/>
      <xs:element name="PmtMtd" type="tns:Max35Text"/>
      <xs:element name="BtchBookg" type="xs:boolean" minOccurs="0"/>
      <xs:element name="NbOfTxs" type="tns:Max15NumericText"/>
      <xs:element name="CtrlSum" type="xs:decimal"/>
      <xs:element name="PmtTpInf" type="tns:PaymentTypeInformation26" minOccurs="0"/>
      <xs:element name="ReqdExctnDt" type="tns:ISODate"/>
      <xs:element name="Dbtr" type="tns:PartyIdentification135"/>
      <xs:element name="DbtrAcct" type="tns:CashAccount38"/>
      <xs:element name="DbtrAgt" type="tns:FinancialInstitutionIdentification18" minOccurs="0"/>
      <xs:element name="ChrgBr" type="tns:ChargeBearerType1Code" minOccurs="0"/>
      <xs:element name="CdtTrfTxInf" type="tns:CreditTransferTransaction" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="GroupHeader">
    <xs:sequence>
      <xs:element name="MsgId" type="tns:Max35Text"/>
      <xs:element name="CreDtTm" type="tns:ISODateTime"/>
      <xs:element name="NbOfTxs" type="tns:Max15NumericText"/>
      <xs:element name="CtrlSum" type="xs:decimal"/>
      <xs:element name="InitgPty" type="tns:PartyIdentification135"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CstmrCdtTrfInitnV11">
    <xs:sequence>
      <xs:element name="GrpHdr" type="tns:GroupHeader"/>
      <xs:element name="PmtInf" type="tns:PaymentInstruction" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Document">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="CstmrCdtTrfInitn" type="tns:CstmrCdtTrfInitnV11"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
