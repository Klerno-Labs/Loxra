{
  "name": "loxra",
  "version": "2.0.0",
  "description": "Loxra — offline-first desktop app for composing, validating, and converting ISO-20022 messages. Bundled XSDs, legacy-format adapters (SWIFT MT / Fedwire / ACH), folder-bridge automation. Nothing leaves your device.",
  "main": "dist/main/main/main.js",
  "author": "Pegrio LLC <chris@pegrio.com>",
  "homepage": "https://loxra.app",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n renderer,main \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "node scripts/dev-renderer.js",
    "dev:main": "npm run build:main && node scripts/dev-main.js",
    "build": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build:renderer && npm run build:main && electron-builder",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "vitest run",
    "preview": "vite preview",
    "ingest": "ts-node -r tsconfig-paths/register scripts/ingest-cli.ts",
    "api": "ts-node -r tsconfig-paths/register scripts/bridge-server.ts",
    "folder:bridge": "ts-node -r tsconfig-paths/register scripts/folder-bridge.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "amqplib": "^0.10.4",
    "classnames": "^2.5.1",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.0",
    "jszip": "^3.10.1",
    "libxml2-wasm": "^0.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.2",
    "ssh2-sftp-client": "^11.0.0",
    "tailwind-merge": "^2.5.5",
    "xmlbuilder2": "^3.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/amqplib": "^0.10.5",
    "@types/classnames": "^2.3.4",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "com.pegrio.loxra",
    "productName": "Loxra",
    "icon": "build/icon.png",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/iso20022",
        "to": "iso20022"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
